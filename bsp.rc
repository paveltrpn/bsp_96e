ARCH_DIALOG DIALOG 6, 18, 319, 249
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Make Arch"
FONT 8, "MS Sans Serif"
{
 CONTROL "OK", IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 60, 50, 14
 CONTROL "Cancel", IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 65, 60, 50, 14
 CONTROL "8", IDMA_EDIT1, "EDIT", WS_BORDER | WS_TABSTOP, 8, 23, 23, 12
 CONTROL "20", IDMA_EDIT2, "EDIT", WS_BORDER | WS_TABSTOP, 8, 38, 23, 12
 CONTROL "On X Axis", IDMA_CHECKBOX1, "BUTTON", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 76, 4, 46, 13
 CONTROL "Arch Type", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 6, 39, 10
 CONTROL "Number of Stones in Arch", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 35, 24, 89, 8
 CONTROL "Post Width (Percent of Brush Width: 5-45%)", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 35, 39, 151, 11
 CONTROL "Reset View", IDC_PUSHBUTTON20, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 122, 60, 50, 14
 CONTROL "Pitch +", IDC_PUSHBUTTON21, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 84, 26, 11
 CONTROL "Pitch -", IDC_PUSHBUTTON22, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 99, 26, 11
 CONTROL "Roll +", IDC_PUSHBUTTON23, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 113, 26, 11
 CONTROL "Roll -", IDC_PUSHBUTTON24, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 128, 26, 11
 CONTROL "Left", IDC_PUSHBUTTON25, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 99, 220, 26, 10
 CONTROL "Right", IDC_PUSHBUTTON26, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 129, 220, 26, 10
