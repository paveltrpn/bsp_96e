IDD_CHOOSE_DIRECTORY DIALOG 131, 26, 180, 134
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_3DLOOK
CAPTION "Choose Directory"
FONT 8, "MS Sans Serif"
{
	LTEXT "&Source:", -1, -80, 144, 76, 9
	EDITTEXT -1, -79, 154, 195, 12, ES_AUTOHSCROLL | ES_OEMCONVERT | WS_DISABLED | WS_BORDER | WS_TABSTOP
	LISTBOX -1, -80, 172, 90, 68, LBS_STANDARD | LBS_HASSTRINGS | LBS_DISABLENOSCROLL | WS_DISABLED | WS_TABSTOP
	LTEXT "&Directories:", -1, 4, 4, 92, 9
	LTEXT "", -1, 4, 16, 112, 9, SS_NOPREFIX
	LISTBOX -1, 4, 28, 112, 72, LBS_SORT | LBS_HASSTRINGS | LBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
	LTEXT "List Files of &Type:", -1, -80, 242, 90, 9
	COMBOBOX -1, -80, 252, 90, 36, CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_DISABLED | WS_BORDER | WS_VSCROLL | WS_TABSTOP
	LTEXT "Dri&ves:", -1, 4, 104, 92, 9
	COMBOBOX -1, 4, 116, 112, 68, CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | CBS_SORT | CBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP
	DEFPUSHBUTTON "OK", IDOK, 124, 6, 50, 14, WS_GROUP
	PUSHBUTTON "Cancel", IDCANCEL, 124, 24, 50, 14, WS_GROUP
}

IDI_QUAKE ICON "bsp.ico"

BSP_MENU MENU 
{
 POPUP "&File"
 {
  MENUITEM "&New\tCtrl-N", CM_FILENEW
  MENUITEM "&Open...\tCtrl-O", CM_FILEOPEN
  MENUITEM "Close\tCtrl-W", CM_FILECLOSE
