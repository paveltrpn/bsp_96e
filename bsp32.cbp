<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="BSP" />
		<Option pch_mode="2" />
		<Option compiler="mingw32" />
		<Build>
			<Target title="Debug Win32">
				<Option output="c:/bsp/bspvc32-dbg" prefix_auto="1" extension_auto="1" />
				<Option object_output="Debug" />
				<Option type="0" />
				<Option compiler="mingw32" />
				<Compiler>
					<Add option="-std=c++98" />
					<Add option="-g" />
					<Add option="-O0" />
					<Add option="-D_WIN32" />
					<Add option="-DDEBUG" />
					<Add option="-D_WINDOWS" />
					<Add directory="lib/png" />
					<Add directory="lib/zlib" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="lib/png" />
					<Add directory="lib/zlib" />
				</ResourceCompiler>
				<Linker>
					<Add option="-Wl,--large-address-aware" />
					<Add library="comctl32" />
					<Add library="OpenGL32" />
					<Add library="GlU32" />
					<Add library="ddraw" />
					<Add library="dxguid" />
					<Add library="lib\mingw32\libpng.a" />
					<Add library="lib\mingw32\libz.a" />
					<Add directory="lib" />
				</Linker>
				<ExtraCommands>
					<Add before="buildver.bat" />
				</ExtraCommands>
			</Target>
			<Target title="Release Win32">
				<Option output="c:/bsp/bspvc32" prefix_auto="1" extension_auto="1" />
				<Option object_output="Release" />
				<Option type="0" />
				<Option compiler="mingw32" />
				<Compiler>
					<Add option="-march=corei7" />
					<Add option="-fomit-frame-pointer" />
					<Add option="-O2" />
					<Add option="-mmmx" />
					<Add option="-fno-exceptions" />
					<Add option="-DWIN32" />
					<Add option="-DNDEBUG" />
					<Add option="-D_UNICODE" />
					<Add option="-D_WINDOWS" />
					<Add option="-D__MMX__" />
					<Add directory="lib/png" />
					<Add directory="lib/zlib" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="lib/png" />
					<Add directory="lib/zlib" />
				</ResourceCompiler>
				<Linker>
					<Add option="-Wl,--large-address-aware" />
					<Add library="comctl32" />
					<Add library="OpenGL32" />
					<Add library="GlU32" />
					<Add library="ddraw" />
					<Add library="dxguid" />
					<Add library="lib\mingw32\libpng.a" />
					<Add library="lib\mingw32\libz.a" />
					<Add directory="lib" />
				</Linker>
				<ExtraCommands>
					<Add before="buildver.bat" />
				</ExtraCommands>
			</Target>
			<Target title="Release SSE2 Win32">
				<Option output="c:/bsp/bspvc32-sse2" prefix_auto="1" extension_auto="1" />
				<Option object_output="Release SSE2 Win32" />
				<Option type="0" />
				<Option compiler="mingw32" />
				<Compiler>
					<Add option="-march=corei7" />
					<Add option="-fomit-frame-pointer" />
					<Add option="-O2" />
					<Add option="-msse2" />
					<Add option="-fno-exceptions" />
					<Add option="-DWIN32" />
					<Add option="-DNDEBUG" />
					<Add option="-D_UNICODE" />
					<Add option="-D_WINDOWS" />
					<Add option="-D__MMX__" />
					<Add option="-D__SSE__" />
					<Add option="-D__SSE2__" />
					<Add option="-D__SSE3__" />
					<Add directory="lib/png" />
					<Add directory="lib/zlib" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="lib/png" />
					<Add directory="lib/zlib" />
				</ResourceCompiler>
				<Linker>
					<Add option="-Wl,--large-address-aware" />
					<Add library="comctl32" />
					<Add library="OpenGL32" />
					<Add library="GlU32" />
					<Add library="ddraw" />
					<Add library="dxguid" />
					<Add library="lib\mingw32\libpng.a" />
					<Add library="lib\mingw32\libz.a" />
					<Add directory="lib" />
				</Linker>
				<ExtraCommands>
					<Add before="buildver.bat" />
				</ExtraCommands>
			</Target>
		</Build>
